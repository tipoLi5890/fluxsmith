{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fluxsmith",
  "version": "0.1.0",
  "identifier": "dev.fluxsmith.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://openrouter.ai https://api.x.ai https://api.groq.com https://api.mistral.ai https://chatgpt.com https://auth.openai.com http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../skills/**/*",
      "../examples/ldo_3v3/ldo_3v3.kicad_pro",
      "../examples/ldo_3v3/ldo_3v3.kicad_sch"
    ],
    "fileAssociations": [
      {
        "ext": ["kicad_pro"],
        "name": "KiCad project",
        "description": "KiCad project",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["kicad_sch"],
        "name": "KiCad schematic",
        "description": "KiCad schematic",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
